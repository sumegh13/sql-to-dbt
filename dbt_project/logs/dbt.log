  create view "warehouse"."main"."mom_growth__dbt_tmp" as (
    WITH m AS (
    SELECT
        year(order_date) AS yr,
        month(order_date) AS mo,
        SUM(amount) AS rev
    FROM "warehouse"."legacy"."orders"
    WHERE rtrim(upper(status)) NOT IN ('CANCELLED', 'RETURNED')
    GROUP BY year(order_date), month(order_date)
),
l AS (
    SELECT
        yr,
        mo,
        rev,
        LAG(rev) OVER (ORDER BY yr, mo) AS prev_rev
    FROM m
)
SELECT
    yr,
    mo,
    rev,
    prev_rev,
    ROUND(CAST((rev - prev_rev) * 100 AS DOUBLE) / NULLIF(prev_rev, 0), 2) AS growth_pct
FROM l
  );

