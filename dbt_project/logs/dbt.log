  create view "warehouse"."main"."product_return_rate__dbt_tmp" as (
    select
    p.product_id,
    p.product_name,
    count(*) as line_count,
    cast(sum(case when rtrim(lower(o.status)) = 'returned' then 1 else 0 end) as integer) as returned_lines,
