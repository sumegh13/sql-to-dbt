  create view "warehouse"."main"."rolling_30d_revenue__dbt_tmp" as (
    WITH src AS (
    SELECT order_date, amount, status
    FROM "warehouse"."legacy"."orders"
),
days AS (
    SELECT DISTINCT order_date
    FROM src
)
SELECT
    d.order_date AS order_date,
    (
        SELECT SUM(o2.amount)
        FROM src o2
        WHERE o2.order_date > d.order_date - 30
          AND o2.order_date <= d.order_date
          AND LOWER(RTRIM(o2.status)) NOT IN ('cancelled', 'returned')
    ) AS rolling_30d
FROM days d
  );

