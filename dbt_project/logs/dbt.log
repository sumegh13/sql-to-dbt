  create view "warehouse"."main"."status_pivot__dbt_tmp" as (
    WITH src AS (
    SELECT
        customer_id,
        order_id,
        LOWER(RTRIM(status)) AS status_norm
    FROM "warehouse"."legacy"."orders"
)
SELECT
    customer_id,
    COUNT(order_id) FILTER (WHERE status_norm = 'shipped') AS shipped,
    COUNT(order_id) FILTER (WHERE status_norm = 'pending') AS pending,
    COUNT(order_id) FILTER (WHERE status_norm = 'cancelled') AS cancelled
FROM src
GROUP BY customer_id
  );

