  create view "warehouse"."main"."avg_item_by_category__dbt_tmp" as (
    WITH base AS (
    SELECT
        p.category,
        CAST(ROUND(i.qty * i.unit_price * 100) AS BIGINT) AS cents
    FROM "warehouse"."legacy"."order_items" i
    JOIN "warehouse"."legacy"."products" p
        ON p.product_id = i.product_id
),
agg AS (
    SELECT
        LOWER(RTRIM(category)) AS grp_key,
        MIN(category) AS category,
        SUM(cents) AS total_cents,
        COUNT(*) AS line_count
    FROM base
    GROUP BY 1
)
SELECT
    category,
    ROUND(CAST(total_cents // line_count AS DOUBLE) / 100, 2) AS avg_line_value,
    line_count
FROM agg
  );

