  create view "warehouse"."main"."avg_item_by_category__dbt_tmp" as (
    WITH base AS (
    SELECT p.category, i.qty, i.unit_price
    FROM "warehouse"."legacy"."order_items" i
    JOIN "warehouse"."legacy"."products" p ON p.product_id = i.product_id
),
agg AS (
    SELECT
        MIN(category) AS category,
        SUM(CAST(ROUND(qty * unit_price * 100) AS BIGINT)) AS total_cents,
        COUNT(qty * unit_price) AS n_nonnull,
        COUNT(*) AS line_count
    FROM base
    GROUP BY LOWER(RTRIM(category))
)
SELECT
    category,
    CASE
        WHEN n_nonnull > 0
        THEN CAST(CAST(total_cents // n_nonnull AS DECIMAL(38,2)) / 100 AS DECIMAL(38,2))
        ELSE NULL
    END AS avg_line_value,
    line_count
FROM agg
  );

