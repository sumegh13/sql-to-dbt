[0m23:01:17.194811 [debug] [Thread-1 (]: On model.migrated.avg_item_by_category: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "migrated", "target_name": "dev", "node_id": "model.migrated.avg_item_by_category"} */

  
  create view "warehouse"."main"."avg_item_by_category__dbt_tmp" as (
    WITH base AS (
    SELECT
        p.category,
        CAST(ROUND(i.qty * i.unit_price * 100) AS BIGINT) AS cents
    FROM "warehouse"."legacy"."order_items" i
    JOIN "warehouse"."legacy"."products" p
        ON p.product_id = i.product_id
),
agg AS (
    SELECT
        LOWER(RTRIM(category)) AS grp_key,
        MIN(category) AS category,
        SUM(cents) AS total_cents,
        COUNT(*) AS line_count
    FROM base
    GROUP BY 1
)
SELECT
    category,
    CAST((total_cents * 10000 // line_count) AS DOUBLE) / 1000000.0 AS avg_line_value,
    line_count
FROM agg
  );

