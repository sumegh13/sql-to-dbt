  create view "warehouse"."main"."legacy_code_cleanup__dbt_tmp" as (
    WITH src AS (
    SELECT
        customer_id,
        legacy_code,
        NULLIF(TRIM(legacy_code), '') AS t
    FROM "warehouse"."legacy"."customers"
),
parsed AS (
    SELECT
        customer_id,
        legacy_code,
        CASE
            WHEN regexp_matches(t, '^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)$')
            THEN TRY_CAST(TRUNC(TRY_CAST(t AS DOUBLE)) AS BIGINT)
        END AS v
    FROM src
),
ranged AS (
    SELECT
        customer_id,
        legacy_code,
        CASE
            WHEN v BETWEEN -2147483648 AND 2147483647 THEN CAST(v AS INTEGER)
        END AS legacy_code_num
    FROM parsed
)
SELECT
    customer_id,
    legacy_code,
    legacy_code_num,
    CASE WHEN legacy_code_num IS NULL THEN 1 ELSE 0 END AS invalid
FROM ranged
  );

