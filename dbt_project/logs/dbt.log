  create view "warehouse"."main"."payment_status__dbt_tmp" as (
    with paid_totals as (
    select
        o.order_id,
        o.amount,
        coalesce(sum(p.paid_amount), 0) as paid
    from "warehouse"."legacy"."orders" o
    left join "warehouse"."legacy"."payments" p
        on p.order_id = o.order_id
    group by o.order_id, o.amount
)
select
    order_id,
    amount,
    paid,
    case
        when paid >= amount then 'paid'
        when paid > 0 then 'partial'
        else 'unpaid'
    end as payment_status
from paid_totals
  );

