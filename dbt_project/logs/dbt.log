  create view "warehouse"."main"."monthly_revenue__dbt_tmp" as (
    WITH valid_orders AS (
    SELECT
        order_date,
        amount
    FROM "warehouse"."legacy"."orders"
    -- T-SQL comparisons are case-insensitive and ignore trailing spaces,
    -- so normalise before comparing against the excluded statuses.
    WHERE LOWER(RTRIM(status)) NOT IN ('cancelled', 'returned')
)
SELECT
    YEAR(order_date) AS yr,
    MONTH(order_date) AS mo,
    CAST(SUM(amount) AS DECIMAL(38, 2)) AS revenue
FROM valid_orders
GROUP BY YEAR(order_date), MONTH(order_date)
  );

