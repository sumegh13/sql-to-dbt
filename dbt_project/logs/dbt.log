[0m23:06:56.269623 [debug] [Thread-1 (]: On model.migrated.payment_balance_cursor: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "migrated", "target_name": "dev", "node_id": "model.migrated.payment_balance_cursor"} */

  
  create view "warehouse"."main"."payment_balance_cursor__dbt_tmp" as (
    WITH base AS (
    SELECT
        p.payment_id,
        p.order_id,
        p.paid_date,
        p.paid_amount,
        o.amount
    FROM "warehouse"."legacy"."payments" p
    JOIN "warehouse"."legacy"."orders" o
        ON o.order_id = p.order_id
),
running AS (
    SELECT
        payment_id,
        order_id,
        paid_amount,
        amount,
        -- T-SQL: once @cum becomes NULL (a NULL paid_amount), it stays NULL for the rest of the order
        CASE
            WHEN COUNT(*) OVER w > COUNT(paid_amount) OVER w THEN NULL
            ELSE SUM(paid_amount) OVER w
        END AS cum
    FROM base
    WINDOW w AS (
        PARTITION BY order_id
        ORDER BY paid_date, payment_id
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    )
)
SELECT
    CAST(payment_id AS INTEGER) AS payment_id,
    CAST(order_id AS INTEGER) AS order_id,
    CAST(paid_amount AS DECIMAL(18,2)) AS paid_amount,
    CAST(cum AS DECIMAL(18,2)) AS cumulative_paid,
    CAST(amount - cum AS DECIMAL(18,2)) AS balance_after,
    CASE WHEN cum > amount THEN 1 ELSE 0 END AS overpaid
FROM running
