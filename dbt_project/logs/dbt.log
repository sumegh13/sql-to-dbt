  create view "warehouse"."main"."median_order_by_region__dbt_tmp" as (
    SELECT
    MIN(c.region) AS region,
    CAST(QUANTILE_CONT(CAST(o.amount AS DOUBLE), 0.5) AS DECIMAL(18,2)) AS median_amount
FROM "warehouse"."legacy"."orders" o
JOIN "warehouse"."legacy"."customers" c
    ON c.customer_id = o.customer_id
GROUP BY UPPER(RTRIM(c.region))
  );

