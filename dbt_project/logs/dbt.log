  create view "warehouse"."main"."order_outstanding_update_join__dbt_tmp" as (
    WITH payment_totals AS (
    SELECT
        order_id,
        SUM(paid_amount) AS total_paid,
        MAX(paid_date) AS last_paid_date
    FROM "warehouse"."legacy"."payments"
    GROUP BY order_id
),
order_payments AS (
    SELECT
        o.order_id,
        o.amount,
        CAST(
            CASE WHEN p.order_id IS NULL THEN 0 ELSE p.total_paid END
            AS DECIMAL(18,2)
        ) AS paid,
        CAST(p.last_paid_date AS DATE) AS last_paid
    FROM "warehouse"."legacy"."orders" o
    LEFT JOIN payment_totals p
        ON p.order_id = o.order_id
)
SELECT
    order_id,
    amount,
    paid,
    CAST(amount AS DECIMAL(18,2)) - paid AS outstanding,
    last_paid
FROM order_payments
  );

