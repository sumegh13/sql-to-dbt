  create view "warehouse"."main"."median_order_by_region__dbt_tmp" as (
    WITH joined AS (
    SELECT
        lower(rtrim(c.region)) AS region_key,
        c.region AS region,
        o.amount AS amount
    FROM "warehouse"."legacy"."orders" o
    JOIN "warehouse"."legacy"."customers" c
        ON c.customer_id = o.customer_id
)
SELECT
    min(region) AS region,
    CAST(quantile_cont(amount, 0.5) AS DECIMAL(18,2)) AS median_amount
FROM joined
GROUP BY region_key
  );

