  create view "warehouse"."main"."daily_calendar_loop__dbt_tmp" as (
    WITH RECURSIVE cal AS (
    SELECT CAST(DATE '2025-11-01' AS DATE) AS cal_date
    UNION ALL
    SELECT CAST(cal_date + INTERVAL 1 DAY AS DATE)
    FROM cal
    WHERE cal_date < DATE '2025-12-31'
),
daily AS (
    SELECT order_date, COUNT(*) AS n
    FROM "warehouse"."legacy"."orders"
    GROUP BY order_date
)
SELECT
    c.cal_date,
    CAST(COALESCE(d.n, 0) AS INTEGER) AS orders_placed
FROM cal c
LEFT JOIN daily d
    ON d.order_date = c.cal_date
  );

