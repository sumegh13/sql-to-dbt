  create view "warehouse"."main"."dept_salary_rank__dbt_tmp" as (
    SELECT
    employee_id,
    emp_name,
    department,
    salary,
    DENSE_RANK() OVER (PARTITION BY department ORDER BY salary DESC) AS dept_rank,
    CAST(
        ROUND(
            CAST(salary AS DECIMAL(38,10)) * 100
            / CAST(SUM(salary) OVER (PARTITION BY department) AS DECIMAL(38,10)),
            2
        ) AS DECIMAL(5,2)
    ) AS pct_of_dept
FROM "warehouse"."legacy"."employees"
  );

