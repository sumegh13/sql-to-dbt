  create view "warehouse"."main"."running_total_cursor__dbt_tmp" as (
    WITH base AS (
    SELECT
        customer_id,
        order_id,
        order_date,
        amount,
        ROW_NUMBER() OVER (
            ORDER BY customer_id NULLS FIRST, order_date NULLS FIRST, order_id NULLS FIRST
        ) AS rn
    FROM "warehouse"."legacy"."orders"
),
keyed AS (
    SELECT
        customer_id,
        order_id,
        order_date,
        amount,
        CASE WHEN customer_id IS NULL THEN rn END AS null_key
    FROM base
),
calc AS (
    SELECT
        customer_id,
        order_id,
        order_date,
        amount,
        SUM(CASE WHEN amount IS NULL THEN 1 ELSE 0 END) OVER (
            PARTITION BY customer_id, null_key
            ORDER BY order_date NULLS FIRST, order_id NULLS FIRST
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS nulls_so_far,
        SUM(amount) OVER (
            PARTITION BY customer_id, null_key
            ORDER BY order_date NULLS FIRST, order_id NULLS FIRST
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS run_sum
    FROM keyed
)
SELECT
    customer_id,
    order_id,
    order_date,
    amount,
    CAST(
        CASE WHEN nulls_so_far > 0 THEN NULL ELSE run_sum END
        AS DECIMAL(18,2)
    ) AS running_total
FROM calc
  );

