[0m23:02:53.654464 [debug] [Thread-1 (]: On model.migrated.temp_table_pipeline: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "migrated", "target_name": "dev", "node_id": "model.migrated.temp_table_pipeline"} */

  
  create view "warehouse"."main"."temp_table_pipeline__dbt_tmp" as (
    WITH spend AS (
    SELECT
        customer_id,
        SUM(amount) AS spend
    FROM "warehouse"."legacy"."orders"
    WHERE RTRIM(LOWER(status)) NOT IN ('cancelled', 'returned')
    GROUP BY customer_id
),
joined AS (
    SELECT
        c.customer_id,
        c.customer_name,
        COALESCE(s.spend, 0) AS spend
    FROM "warehouse"."legacy"."customers" c
    LEFT JOIN spend s
        ON s.customer_id = c.customer_id
),
stats AS (
    SELECT
        customer_id,
        customer_name,
        spend,
        SUM(spend) OVER () AS total_spend,
        COUNT(*) OVER () AS n
    FROM joined
)
SELECT
    customer_id,
    customer_name,
    spend,
    CASE
        WHEN CAST(spend AS DECIMAL(38, 2)) * n > total_spend THEN 'above_avg'
        ELSE 'at_or_below_avg'
    END AS vs_avg
FROM stats
  );

