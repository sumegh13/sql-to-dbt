[0m23:04:53.470857 [debug] [Thread-1 (]: On model.migrated.item_volume_discount_cursor: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "migrated", "target_name": "dev", "node_id": "model.migrated.item_volume_discount_cursor"} */

  
  create view "warehouse"."main"."item_volume_discount_cursor__dbt_tmp" as (
    WITH base AS (
    SELECT
        item_id,
        order_id,
        qty,
        SUM(CASE WHEN qty IS NULL THEN 1 ELSE 0 END) OVER (
            PARTITION BY order_id
            ORDER BY item_id
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS null_cnt,
        SUM(qty) OVER (
            PARTITION BY order_id
            ORDER BY item_id
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS run_sum
    FROM "warehouse"."legacy"."order_items"
),
calc AS (
    SELECT
        item_id,
        order_id,
        qty,
        CASE WHEN null_cnt > 0 THEN NULL ELSE CAST(run_sum AS INTEGER) END AS running_qty
    FROM base
)
SELECT
    item_id,
    order_id,
    qty,
    running_qty,
    CAST(
        CASE
            WHEN running_qty >= 10 THEN 10
            WHEN running_qty >= 5 THEN 5
            ELSE 0
        END
    AS INTEGER) AS discount_pct
FROM calc
  );

