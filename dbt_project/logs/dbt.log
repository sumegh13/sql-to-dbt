  create view "warehouse"."main"."buyers_by_region__dbt_tmp" as (
    WITH buyer_rows AS (
    SELECT c.region, c.customer_id
    FROM "warehouse"."legacy"."customers" c
    INNER JOIN "warehouse"."legacy"."orders" o
        ON o.customer_id = c.customer_id
)
