  create view "warehouse"."main"."inventory_pivot__dbt_tmp" as (
    WITH src AS (
    SELECT
        product_id,
        UPPER(RTRIM(warehouse)) AS wh,
        qty_on_hand
    FROM "warehouse"."legacy"."inventory"
)
SELECT
    product_id,
    COALESCE(CAST(SUM(CASE WHEN wh = 'A' THEN qty_on_hand END) AS INTEGER), 0) AS wh_a,
