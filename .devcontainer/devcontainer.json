{
  "name": "sql-to-dbt",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "containerEnv": {
    "HOST": "0.0.0.0",
    "MSSQL_HOST": "mssql",
    "MSSQL_SA_PASSWORD": "Legacy_Pass123",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Migration app",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install --user --quiet uv && ~/.local/bin/uv sync",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postAttachCommand": "bash .devcontainer/start.sh"
}
